#!/bin/bash

echo "$(date) $0 Script started" >> /var/log/fortinet/$(basename $0).log

MODE_NAME="1728x1080_60.00"
OUTPUT_NAME="Virtual-1"

# Check if DISPLAY is set
if [ -z "$DISPLAY" ]; then
  export DISPLAY=:0
fi

# Check if xrandr can run
if ! xrandr >/dev/null 2>&1; then
  echo "xrandr failed or X server is not available on DISPLAY=$DISPLAY"
  exit 1
fi

# Check if mode exists
if ! xrandr | grep -q "$MODE_NAME"; then
  echo "Creating mode $MODE_NAME"
  xrandr --newmode "$MODE_NAME" 157.50 1728 1824 2000 2272 1080 1083 1093 1120 -hsync +vsync
fi

# Check if mode is added to the output
if ! xrandr --query | grep -A1 "^$OUTPUT_NAME" | grep -q "$MODE_NAME"; then
  echo "Adding mode $MODE_NAME to $OUTPUT_NAME"
  xrandr --addmode "$OUTPUT_NAME" "$MODE_NAME"
fi

# Set the resolution
echo "Setting $MODE_NAME on $OUTPUT_NAME"
#xrandr --output "$OUTPUT_NAME" --mode "$MODE_NAME"
xrandr --output Virtual-1 --mode "1280x720"

setxkbmap -layout us,ch -variant ,de -option grp:shifts_toggle

