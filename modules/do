# https://docs.tigera.io/calico-cloud/network-policy/policy-firewalls/fortinet-integration/firewall-integration

kubectl create namespace tigera-firewall-controller

cat > tigera-network-policy.yaml <<EOF
apiVersion: projectcalico.org/v3
kind: GlobalNetworkPolicy
metadata:
  name: default.production-microservice1
spec:
  selector: "app == 'toolbox'"
  types:
    - Egress
  egress:
    - action: Allow
EOF
kubectl apply -f tigera-network-policy.yaml 

cat > tigera-firewall-config.yaml <<EOF
# Configuration of Tigera Firewall Controller
kind: ConfigMap
apiVersion: v1
metadata:
  name: tigera-firewall-controller-configs
  namespace: tigera-firewall-controller
data:
  # FortiGate device information
  tigera.firewall.fortigate: |
    - name: prod-east1
      ip: 10.1.1.1
      apikey:
        secretKeyRef:
          name: fortigate
          key: 9pwsythxqqgsk3qg0N9sgb3G3s50N6
  tigera.firewall.fortimgr: |
    - name: fortimgr
      ip: 10.1.1.2
      username: tigera
      adom: root
      password:
        secretKeyRef:
          name: fortimgr
          key: F0rt!net
EOF

kubectl apply -f tigera-firewall-config.yaml

