# Create Log Firectory
mkdir -p /var/log/fortinet && chown fortinet:fortinet /var/log/fortinet

# Set correct permision and ownership
[ -d /home/fortinet ] && chown -R fortinet:fortinet /home/fortinet

echo "=> Configure Password-Less SuDo"
chown root:root /etc/sudoers.d /etc/sudoers.d/fortinet
chmod 440 /etc/sudoers.d/fortinet

sleep 60

echo "=> Deploy Docker Applications"
[ $APP_EDB_DOCKER -eq 1 ] &&  echo "   ▪ Deploy \$HOME/bin/deploy-edb-docker.sh" && su - fortinet -c "/home/fortinet/bin/deploy-edb-docker.sh"
[ $APP_ECHOSERVER_DOCKER -eq 1 ] && echo "   ▪ Deploy \$HOME/bin/deploy-echoserver-docker.sh" && su - fortinet -c "/home/fortinet/bin/deploy-echoserver-docker.sh"
[ $APP_GLOBEX_DOCKER -eq 1 ] && echo "   ▪ Deploy \$HOME/bin/deploy-globex-docker.sh" && su - fortinet -c "/home/fortinet/bin/deploy-globex-docker.sh"
[ $APP_APEX_DOCKER -eq 1 ] && echo "   ▪ Deploy \$HOME/bin/deploy-apec-docker.sh" && su - fortinet -c "/home/fortinet/bin/deploy-apex-docker.sh"
[ $APP_ACME_DOCKER -eq 1 ] && echo "   ▪ Deploy \$HOME/bin/deploy-acme-docker.sh" && su - fortinet -c "/home/fortinet/bin/deploy-acme-docker.sh"

