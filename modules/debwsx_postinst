echo "######################### Start fortipoc/postinst (debwsX)) ###########################"

echo "=> Update Installed Packages"
apt update -qq > /dev/null 2>&1; ret=$?
[ $ret -ne 0 ] && echo "   ▪ Package update failed, check internet connection" && exit 1

e cho "=> Installing Additional Packages"
apt install curl net-tools traceroute jq -y -qq  > /dev/null 2>&1

